{
  "name": "@inertiajs/devtools-extension",
  "version": "0.6.5",
  "license": "MIT",
  "private": true,
  "description": "Browser DevTools panel for inspecting Inertia.js requests, props, routes, and page state.",
  "contributors": [
    "Pascal Baljet <pascal@laravel.com>"
  ],
  "keywords": [
    "inertia",
    "inertiajs",
    "devtools",
    "chrome-extension",
    "firefox-addon",
    "mv3",
    "developer-tools"
  ],
  "homepage": "https://inertiajs.com/devtools",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inertiajs/inertia-devtools.git"
  },
  "bugs": {
    "url": "https://github.com/inertiajs/inertia-devtools/issues"
  },
  "type": "module",
  "dependencies": {
    "@lucide/vue": "^1.17.0"
  },
  "scripts": {
    "dev:chrome": "EXTENSION_TARGET=chrome vite build --watch --mode development",
    "dev:firefox": "EXTENSION_TARGET=firefox vite build --watch --mode development",
    "build:chrome": "EXTENSION_TARGET=chrome vite build",
    "build:firefox": "EXTENSION_TARGET=firefox vite build",
    "clean": "rm -rf dist-chrome dist-firefox",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.ts",
    "test:e2e:chrome": "playwright test -c tests/e2e/playwright.config.ts --project=chromium-selenium",
    "test:e2e:firefox": "playwright test -c tests/e2e/playwright.config.ts --project=firefox",
    "format": "oxfmt",
    "lint": "oxlint ."
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@tailwindcss/vite": "^4.0.0",
    "@types/chrome": "^0.0.281",
    "@types/node": "^24.10.13",
    "@types/selenium-webdriver": "^4.35.6",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.11",
    "happy-dom": "^20.11.2",
    "oxfmt": "^0.51.0",
    "oxlint": "^1.66.0",
    "selenium-webdriver": "^4.46.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "vitest": "^4.1.2",
    "vue": "^3.5.13"
  }
}
